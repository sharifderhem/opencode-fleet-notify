{
  "name": "opencode-fleet-notify",
  "version": "0.5.0",
  "description": "Fleet notifications for OpenCode 1.x and 2.x with explicit acknowledgments",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "index.ts",
    "tui.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "mock-server": "node scripts/mock-server.mjs",
    "test": "node --loader ./scripts/ts-loader.mjs test/all.mjs",
    "test:host": "node scripts/verify-host.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharifderhem/opencode-fleet-notify"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.19.3",
    "@opencode/plugin": "2.1.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "solid-js": "^1.9.17",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
