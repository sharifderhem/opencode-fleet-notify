{
  "name": "opencode-fleet-notify",
  "version": "0.6.1",
  "description": "Fleet notifications for OpenCode 1.x and 2.x with explicit acknowledgments",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "index.ts",
    "tui.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "mock-server": "node scripts/mock-server.mjs",
    "test": "node --loader ./scripts/ts-loader.mjs test/all.mjs",
    "test:host": "node scripts/verify-host.mjs",
    "test:features:host": "node scripts/verify-features-host.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:desktop": "npm run build && node scripts/verify-desktop.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharifderhem/opencode-fleet-notify"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.19.3",
    "@opencode/plugin": "2.1.1",
    "fflate": "^0.8.2",
    "solid-js": "^1.9.17"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
